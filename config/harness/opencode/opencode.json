{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "websearch": false,
  "formatter": false,
  "snapshots": false,
  "providers": {
    "anthropic": {
      "settings": {
        "baseURL": "http://172.30.0.3:8080/v1",
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  },
  "permissions": [
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "build": { "steps": 50 }
  }
}
